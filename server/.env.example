# Скопируйте в .env (для локального запуска) или вбейте значения
# в раздел Environment Variables на Timeweb Cloud Apps.

PORT=3000
ALLOWED_ORIGIN=*

# Timeweb AI Agent
TIMEWEB_AGENT_ID=d43b70f8-5d42-476b-9de3-1ccdeac62b78
TIMEWEB_TOKEN=  # Bearer-токен агента (тот же, что был в Cloudflare)

# GitHub-хранилище JSON
GITHUB_REPO=MagisterGudvin/nutri-data
GITHUB_BRANCH=main
GITHUB_TOKEN=   # fine-grained PAT, Contents: Read & Write
